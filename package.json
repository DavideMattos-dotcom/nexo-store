{
 "name": "nexo-store-cloudflare",
 "version": "1.0.0",
 "private": true,
 "type": "module",
 "engines": {
  "node": ">=22.13.0"
 },
 "scripts": {
  "build": "vite build",
  "dev": "npm run build && wrangler dev",
  "deploy": "npm run build && wrangler deploy",
  "db:migrate": "wrangler d1 migrations apply nexo-store-db --remote",
  "db:seed": "wrangler d1 execute nexo-store-db --remote --file=seed.sql",
  "setup:admin": "node scripts/setup-admin.mjs",
  "check": "tsc --noEmit",
  "test": "node --experimental-strip-types --test tests/*.test.mjs"
 },
 "dependencies": {
  "lucide-react": "1.31.0",
  "react": "19.2.6",
  "react-dom": "19.2.6"
 },
 "devDependencies": {
  "@cloudflare/workers-types": "5.20261018.1",
  "@types/node": "22.19.19",
  "@types/react": "19.2.14",
  "@types/react-dom": "19.2.3",
  "@vitejs/plugin-react": "6.0.2",
  "typescript": "5.9.3",
  "vite": "8.3.4",
  "wrangler": "4.151.1"
 }
}
